                  <photoshop:LayerText>Lead of Techarea</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Moh. Roziq Bahtiar, S.Pd</photoshop:LayerName>
                  <photoshop:LayerText>Moh. Roziq Bahtiar, S.Pd</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
