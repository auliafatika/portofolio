               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>OF INTERNSHIP</photoshop:LayerName>
                  <photoshop:LayerText>OF INTERNSHIP</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>This certificate is awarded to</photoshop:LayerName>
                  <photoshop:LayerText>This certificate is awarded to</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>in appreciation for your successful work as a  UI/UX Designer I</photoshop:LayerName>
                  <photoshop:LayerText>in appreciation for your successful work as a  UI/UX Designer Intern at Techarea.  The internship was conducted between  28th of July 2025 to 28th of December 2025.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Name</photoshop:LayerName>
                  <photoshop:LayerText>Aulia Fatika Rahmadani</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Internship Supervisor</photoshop:LayerName>
                  <photoshop:LayerText>Internship Supervisor</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Andre Harrera, S.S M.I.Kom</photoshop:LayerName>
                  <photoshop:LayerText>Andre Harrera, S.S M.I.Kom</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
